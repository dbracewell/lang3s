# -----------------------------------------------------------------------------
# Lang3s Frontend environment variables
# Copy this file to `.env` and fill in real values for your environment.
# -----------------------------------------------------------------------------

# Inngest API base URL used by the frontend app.
INNGEST_URL=http://localhost:8288

# Better Auth secret used to sign auth tokens/sessions.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Public URL where Better Auth endpoints are served.
BETTER_AUTH_URL=http://localhost:3000

# Public URL for the frontend app itself.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public base URL for backend API (proxied Python services).
NEXT_PUBLIC_BACKEND_URL=http://localhost:8003

# Passphrase used during install/bootstrap flow to create the admin account.
ADMIN_PASSPHRASE=replace-with-admin-passphrase

# Internal system API key for trusted service-to-service operations.
# Needs to match the same key in backend
SYSTEM_KEY=replace-with-system-key

# Redis host used by server-side frontend features.
REDIS_HOST=localhost

# Redis port.
REDIS_PORT=6379

# Redis database index.
REDIS_DB=0

# Inngest signing key / event key.
INNGEST_SIGNING_KEY=replace-with-inngest-signing-key

# SQLite file path for Better Auth user database.
DATABASE_URL=./users.db

# Absolute path to the filestore directory
FILESTORE_ROOT=/absolute/path/to/Lang3s/filestore
