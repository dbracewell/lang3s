{% import 'macros.sql' as macros %}

WITH entity_topics AS (SELECT
                           -- Assuming 'normalized' in your view is the entity text/id
                           a.text   as entity,
                           a.path   as type,
                           t.topic_id,
                           COUNT(*) as count
                       FROM text_annotations_mapped a
                                INNER JOIN pg_db.topic_sentences t
                                           ON t.sentence_aid = a.sentence_aid
                       WHERE {{ macros.match_paths('a.path', mapping_list) }}
                       GROUP BY a.text, a.path, t.topic_id
                       HAVING count(DISTINCT a.document_id) > 5),
     probabilities AS (SELECT entity,
                              type,
                              -- Window function: count_for_topic / total_count_for_entity
                              count::FLOAT / SUM(count) OVER (PARTITION BY entity, type) as p
                       FROM entity_topics),
     entropy_scores AS (SELECT entity                    as entityId,
                               type                      as entityType,
                               -- Entropy Formula: -SUM(p * log2(p))
                               -- DuckDB uses ln(), so we divide by ln(2) to get base-2 log
                               -SUM(p * (ln(p) / ln(2))) as rawScore
                        FROM probabilities
                        GROUP BY entity, type)
-- Fetch Top and Bottom 25 in one go
SELECT *, 'low' as category
FROM (SELECT *
      FROM entropy_scores
      ORDER BY rawScore ASC
      LIMIT 25)
UNION ALL
SELECT *, 'high' as category
FROM (SELECT *
      FROM entropy_scores
      ORDER BY rawScore DESC
      LIMIT 25)