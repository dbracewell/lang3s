{% import 'macros.sql' as macros %}

select text                                   as content,
       path,
       COUNT(0)                               as count,
       COUNT(DISTINCT document_id)            as docCount,
       count(DISTINCT sentence_aid)           as sentenceCount,
       COUNT(0) / COUNT(DISTINCT document_id) as mentionsPerDocument,
       name                                   as value
from text_annotations_mapped
where {{ macros.match_paths('path', mapping_list) }}
    {% if filter is not none %}
  AND text ilike ?
    {% endif %}
GROUP BY text, path, name
HAVING COUNT(DISTINCT document_id) > 5
order by {{ order_by_col }} desc, text, path
offset ? limit ?