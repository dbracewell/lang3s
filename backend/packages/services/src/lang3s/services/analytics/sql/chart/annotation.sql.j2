{% import 'macros.sql' as macros %}

{{ VALUE_SELECTOR }}
AS
(SELECT normalized || ' (' || name || ')'  as text,
        name                         as value,
        normalized_path,
        count(0)                     as mention_count,
        count(distinct document_id)  as document_count,
        count(distinct sentence_id) as sentence_count
 FROM text_annotations_mapped
 WHERE {{ macros.match_paths('path', mapping_list) }}
 GROUP BY normalized, value, name, normalized_path
 ORDER BY {{ order_by }}
 OFFSET ? LIMIT ?)
,
{{ VALUE_MAPPING }} AS
(SELECT B.text,
       B.value,
       A.document_id,
       A.sentence_id
FROM text_annotations_mapped AS A
         INNER JOIN {{ VALUE_SELECTOR }} B ON A.normalized_path = B.normalized_path
)