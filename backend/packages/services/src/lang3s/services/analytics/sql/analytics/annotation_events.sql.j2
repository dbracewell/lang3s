WITH entity_sentences AS (select DISTINCT e2.sentence_id, e2.content
                          FROM text_annotations_mapped e1
                                   INNER JOIN text_annotations e2 on e1.sentence_id = e2.sentence_id
                          WHERE e1.normalized = ?
                            and e1.path = ?
                            and e2.type = 'sentence')
SELECT a1.normalized                                        as text,
       a2.content                                     as sentence,
       name                                           as value,
       json_extract(metadata_json, '$.A0_TEXT')::VARCHAR[] as A0,
       json_extract(metadata_json, '$.A1_TEXT')::VARCHAR[] as A1,
       metadata_json ->> 'TIME_TEXT'                       as TIME,
       metadata_json ->> 'LOC_TEXT'                        as LOC
FROM text_annotations_mapped a1
         INNER JOIN entity_sentences a2 on a1.sentence_id = a2.sentence_id
WHERE EXISTS (SELECT 1
              FROM UNNEST(json_extract(metadata_json, '$.A0_TEXT')::VARCHAR[]) AS t(tag)
              WHERE UPPER(t.tag) = ?)
   or EXISTS (SELECT 1
              FROM UNNEST(json_extract(metadata_json, '$.A1_TEXT')::VARCHAR[]) AS t(tag)
              WHERE UPPER(t.tag) = ?)
   or UPPER(metadata_json ->> 'TIME_TEXT') = ?
   or UPPER(metadata_json ->> 'LOC_TEXT') = ?