{{ VALUE_SELECTOR }}
AS
(SELECT id, name, support as sentence_count, doc_support as document_count, 0 as mention_count
 FROM pg_db.topics
 ORDER BY {{ order_by }}
 OFFSET ? LIMIT ?)
,
{{ VALUE_MAPPING }} AS
(SELECT B.name as text,
       B.name as value,
       A.doc_id as document_id,
       A.sentence_id
FROM pg_db.topic_sentences AS A
         INNER JOIN {{ VALUE_SELECTOR }} B ON A.topic_id = B.id
)