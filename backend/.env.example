# Backend environment variables
# Copy this file to `.env` and fill in values for your local setup.

# Public URL for the frontend app (used by backend integrations)
NODEJS_HOST=http://localhost:3000

# Database host (PostgreSQL)
POSTGRES_HOST=localhost
# Database user
POSTGRES_USER=username
# Database port
POSTGRES_PORT=port
# Database Password
POSTGRES_PASSWORD=password

# (Optional if using Docker) Redis host
REDIS_HOST=host

# Internal system API key for trusted service-to-service operations.
# Needs to match the same key in frontend
SYSTEM_KEY=replace-with-a-secure-random-secret

# Optional LLM endpoint/model (openai) settings (uncomment if using a custom LLM server)
# LLM_HOST=http://ip:port/v1

# Optional LLM api key (uncomment if using a custom LLM server)
# LLM_API_KEY=api-key

# Name of LLM to use
# LLM_MODEL=model_name

# Absolute path to the filestore directory
FILESTORE_ROOT=/absolute/path/to/Lang3s/filestore
